# Your Comfy API key, from https://platform.comfy.org (a paid Comfy Cloud plan is needed for API access).
# Generations bill the workspace that owns this key. Users can also bring their own key in the app Settings.
COMFY_API_KEY=

# Optional: point the SDK at your own ComfyUI through comfy-api-proxy instead of Comfy Cloud.
# COMFY_BASE_URL=http://127.0.0.1:8189

# Effect graph: "dfr" (LTX-2.5 DFR, sharper, default) or "classic" (two pass i2v, faster).
# VFX4ALL_EFFECT_PIPELINE=dfr

# Hosting it for other people (see "Hosting it" in the README):
# VFX4ALL_MODE=hosted           # jobs and files per browser session, 30 s / 100 MB clips, old runs deleted
# VFX4ALL_ACCESS_CODE=          # every upload and generation needs this code (enter it in Settings)
# VFX4ALL_DAILY_RUNS=50         # generations the server accepts per UTC day (0 = no cap)
# VFX4ALL_SESSION_JOBS=2        # jobs one session may run at once (hosted mode)
# VFX4ALL_IP_JOBS=6             # jobs one IP address may run at once (hosted mode)
# VFX4ALL_RETENTION_HOURS=48    # delete runs and uploads older than this (0 = keep; hosted default 48)
