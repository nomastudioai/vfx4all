# Your Comfy API key, from https://platform.comfy.org (a paid Comfy Cloud plan is needed for API access).
# Generations bill the workspace that owns this key. Users can also bring their own key in the app Settings.
COMFY_API_KEY=

# Optional: point the SDK at your own ComfyUI through comfy-api-proxy instead of Comfy Cloud.
# COMFY_BASE_URL=http://127.0.0.1:8189

# Effect graph: "dfr" (LTX-2.5 DFR, sharper, default) or "classic" (two pass i2v, faster).
# VFX4ALL_EFFECT_PIPELINE=dfr
